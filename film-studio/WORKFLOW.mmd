  classDef jobsClass fill:#261805,stroke:#f57c00,stroke-width:2px,color:#ffffff;
  classDef handoffClass fill:#2a0808,stroke:#e53935,stroke-width:2px,color:#ffffff;
  classDef placementClass fill:#07261c,stroke:#00897b,stroke-width:2px,color:#ffffff;
  classDef prepClass fill:#141d2b,stroke:#5c6bc0,stroke-width:2px,color:#ffffff;
  classDef renderClass fill:#0a2540,stroke:#3949ab,stroke-width:2px,color:#ffffff;
  classDef masterClass fill:#0a3622,stroke:#2e7d32,stroke-width:3px,color:#ffffff;
  classDef auditClass fill:#1a1c29,stroke:#00acc1,stroke-width:2px,color:#ffffff;

  class SrcWS,ImportCLI,ImportSnap intakeClass;
  class ReviewService,InspectorServer,InspectorUI,ReviewLedger reviewClass;
  class JobControlsUI,JobStore,ExtReceipts,JobLedger jobsClass;
  class KlingHandoff,BlockedHandoff handoffClass;
  class CutPlan,PlacementCLI,PlacementManifest placementClass;
  class PrepareCLI,CompositionDir prepClass;
  class GateLint,GateCheck,GateTimeline,EngineRender renderClass;
  class MasterExport masterClass;
  class FullDecode,SSIMCheck,AudioCorr,AuditReceipt auditClass;

  style Stage1 fill:#080e18,stroke:#1565c0,stroke-width:1.5px,color:#90caf9;
  style Stage2 fill:#120824,stroke:#6a1b9a,stroke-width:1.5px,color:#ce93d8;
  style Stage3 fill:#190f02,stroke:#e65100,stroke-width:1.5px,color:#ffb74d;
