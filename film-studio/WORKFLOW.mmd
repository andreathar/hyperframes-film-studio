%% ==============================================================================
%% HyperFrames Film Studio: Complete Implementation & Dataflow Architecture
%% ==============================================================================

flowchart TD

  %% ----------------------------------------------------------------------------
  %% STAGE 1: CANONICAL SOURCE INGESTION & PROVENANCE
  %% ----------------------------------------------------------------------------
  subgraph Stage1["STAGE 1: CANONICAL SOURCE INGESTION & PROVENANCE"]
    SrcWS[("Canonical Film Workspace<br/>Movies_Projects<br/>💡 Hint: Read-only source repository")]
    ImportCLI["Intake Engine CLI<br/>bun run film:import<br/>💡 Hint: Path traversal guard, no source mutation"]
    ImportSnap[("Immutable Import Snapshot<br/>.film-workspace/import.json<br/>💡 Hint: Source hashes, shot namespaces, executionAllowed=false")]
  end

  %% ----------------------------------------------------------------------------
  %% STAGE 2: EDITORIAL REVIEW & INSPECTOR COMPANION UI
  %% ----------------------------------------------------------------------------
  subgraph Stage2["STAGE 2: EDITORIAL REVIEW & INSPECTOR COMPANION UI"]
    ReviewService["Review Engine<br/>bun run film:review<br/>💡 Hint: Pure reducer bound to project + source hash"]
    InspectorServer["Inspector HTTP Server<br/>bun run film:inspect<br/>💡 Hint: Loopback-only 127.0.0.1, Host validation, CSRF, CSP"]
    InspectorUI["Production Inspector Web UI<br/>Browser Companion<br/>💡 Hint: Shot rail, direction notes, candidate selector, reasons"]
    ReviewLedger[("Versioned Review State<br/>review.json<br/>💡 Hint: Replay-verified audit ledger, mapping invalidation rules")]
  end

  %% ----------------------------------------------------------------------------
  %% STAGE 3: DURABLE PROVIDER JOB LEDGER & RESULT RECONCILIATION
  %% ----------------------------------------------------------------------------
  subgraph Stage3["STAGE 3: DURABLE PROVIDER JOB LEDGER & RESULT RECONCILIATION"]
    JobControlsUI["Inspector Job Controls<br/>Selected-Shot UI<br/>💡 Hint: UI for defining generation intent & recording receipts"]
    JobStore["Durable Job Store<br/>bun run film:jobs<br/>💡 Hint: Exclusive .lock, 32MB bounds, request deduplication"]
    ExtReceipts[("External Receipts & Media<br/>results-workspace/receipt.json<br/>💡 Hint: Status tracking, output SHA-256 via /proc/self/fd")]
    JobLedger[("Durable Job Ledger<br/>.film-workspace/jobs/<br/>💡 Hint: Project-bound intent history, terminal state lock")]
  end

  %% ----------------------------------------------------------------------------
  %% STAGE 4: PRODUCER HANDOFF GATEWAY (VENDOR ISOLATION)
  %% ----------------------------------------------------------------------------
  subgraph Stage4["STAGE 4: PRODUCER HANDOFF GATEWAY (VENDOR ISOLATION)"]
    KlingHandoff["Kling Producer Handoff<br/>bun run film:kling-handoff<br/>💡 Hint: Slot mapping, aspect ratio check, zero-write export"]
    BlockedHandoff[("Blocked Candidate Package<br/>runner-spec.json + handoff.json<br/>💡 Hint: auth=null, submissionBlocked=true, Python hash parity")]
  end

  %% ----------------------------------------------------------------------------
  %% STAGE 5: CANDIDATE PLACEMENT & CUT COMPILATION
  %% ----------------------------------------------------------------------------
  subgraph Stage5["STAGE 5: CANDIDATE PLACEMENT & CUT COMPILATION"]
    CutPlan[("Authored Cut Plan<br/>cut-plan.json<br/>💡 Hint: Frame-based timeline: shot keys, candidate takes, trims")]
    PlacementCLI["Placement Compiler<br/>bun run film:place<br/>💡 Hint: Replays review, verifies take media, creates safe aliases"]
    PlacementManifest[("Prepared Manifest & Metadata<br/>manifest.json + placement.json<br/>💡 Hint: Track 0 continuous picture, tracks 1-64 audio")]
  end

  %% ----------------------------------------------------------------------------
  %% STAGE 6: HYPERFRAMES COMPOSITION ASSEMBLY
  %% ----------------------------------------------------------------------------
  subgraph Stage6["STAGE 6: HYPERFRAMES COMPOSITION ASSEMBLY"]
    PrepareCLI["Composition Preparer<br/>bun run film:prepare<br/>💡 Hint: FFmpeg stream duration probe, refuses existing output dirs"]
    CompositionDir[("Editable Composition Folder<br/>.film-workspace/exchange-v1/<br/>💡 Hint: index.html GSAP root, assets/, production.json")]
  end

  %% ----------------------------------------------------------------------------
  %% STAGE 7: QUALITY GATES & DETERMINISTIC MASTER RENDER
  %% ----------------------------------------------------------------------------
  subgraph Stage7["STAGE 7: QUALITY GATES & DETERMINISTIC MASTER RENDER"]
    GateLint["Quality Gate 1: Static Lint<br/>hyperframes lint<br/>💡 Hint: DOM structure, custom elements, clip boundaries"]
    GateCheck["Quality Gate 2: Headless Browser<br/>hyperframes check<br/>💡 Hint: Headless Chrome runtime, layout shifts, WCAG contrast"]
    GateTimeline["Quality Gate 3: Timeline Inspect<br/>hyperframes timeline<br/>💡 Hint: Seekable frame alignment, audio sync verification"]
    EngineRender["Producer & Engine Render<br/>hyperframes render<br/>💡 Hint: Puppeteer frame capture + FFmpeg video/audio encoding"]
    MasterExport[("Master Film Deliverable<br/>exchange-v1.mp4<br/>💡 Hint: 1920x1080 @ 24fps master, stereo AAC 48kHz")]
  end

  %% ----------------------------------------------------------------------------
  %% STAGE 8: POST-RENDER VERIFICATION & AUDIT EVIDENCE
  %% ----------------------------------------------------------------------------
  subgraph Stage8["STAGE 8: POST-RENDER VERIFICATION & AUDIT EVIDENCE"]
    FullDecode["Full Stream Decoding<br/>Decoded Frame Buffer<br/>💡 Hint: 100% video/audio frames decoded, zero dropped frames"]
    SSIMCheck["Visual Fidelity Analysis<br/>Boundary & Midpoint SSIM<br/>💡 Hint: SSIM 0.963 - 0.979 vs browser canvas snapshots"]
    AudioCorr["Acoustic Phase Alignment<br/>Cross-Correlation Analysis<br/>💡 Hint: Multi-track audio mix correlation > 0.9999"]
    AuditReceipt[("Cryptographic Audit Receipt<br/>preparation.json + DELIVERY.md<br/>💡 Hint: End-to-end SHA-256 provenance from script to pixel")]
  end

  %% ============================================================================
  %% DATAFLOW CONNECTIONS & RELATIONSHIPS
  %% ============================================================================

  %% Stage 1 Dataflow
  SrcWS -->|"Read-only scan: activeFilm, script, CSV, takes"| ImportCLI
  ImportCLI -->|"Validates hashes, bounds & emits snapshot"| ImportSnap

  %% Stage 2 Dataflow
  ImportSnap -->|"Binds projectId + source SHA-256"| ReviewService
  ReviewService -->|"Exposes scoped projection & CSRF"| InspectorServer
  InspectorServer <-->|"Two-way HTTP: CSRF + expectedRevision"| InspectorUI
  InspectorUI -->|"Explicit user action: Download Review"| ReviewLedger
  ReviewLedger -.->|"Replay & state restoration"| ReviewService

  %% Stage 3 Dataflow
  InspectorUI -.->|"Discloses job actions for shot"| JobControlsUI
  JobControlsUI -->|"Prepares video intent: route, model, prompt"| JobStore
  ReviewLedger -->|"Supplies active reference roles & hashes"| JobStore
  JobStore -->|"Acquires exclusive .lock & writes intent"| JobLedger
  ExtReceipts -->|"Confined /proc/self/fd inspection up to 2GB"| JobStore
  JobStore -->|"Reconciles receipt: unknown to success"| JobLedger

  %% Stage 4 Dataflow
  JobLedger -->|"Provides prepared kling-cli intent"| KlingHandoff
  ReviewLedger -->|"Validates assigned references & mapping"| KlingHandoff
  SrcWS -.->|"Checks canonical workspace references"| KlingHandoff
  KlingHandoff -->|"Exports blocked candidate package"| BlockedHandoff

  %% Stage 5 Dataflow
  CutPlan -->|"Frame timings, shot keys, volume, rates"| PlacementCLI
  ReviewLedger -->|"Verified candidate take selections"| PlacementCLI
  ImportSnap -->|"Canonical shot directions & line IDs"| PlacementCLI
  PlacementCLI -->|"Generates safe aliases & copies bytes"| PlacementManifest

  %% Stage 6 Dataflow
  PlacementManifest -->|"Manifest v1: tracks 0-64, integer fps"| PrepareCLI
  PrepareCLI -->|"Probes per-stream coverage via FFmpeg"| CompositionDir

  %% Stage 7 Dataflow
  CompositionDir -->|"Input composition HTML & assets"| GateLint
  GateLint -->|"Static AST passes"| GateCheck
  GateCheck -->|"Runtime Chrome execution passes"| GateTimeline
  GateTimeline -->|"Frame-exact seek verified"| EngineRender
  EngineRender -->|"Puppeteer frames + FFmpeg mux"| MasterExport

  %% Stage 8 Dataflow
  MasterExport -->|"Demux & decode all frames"| FullDecode
  FullDecode -->|"Compare rendered frames with browser"| SSIMCheck
  FullDecode -->|"Compare rendered mix with source audio"| AudioCorr
  SSIMCheck -->|"Compile visual evidence"| AuditReceipt
  AudioCorr -->|"Compile acoustic evidence"| AuditReceipt
  CompositionDir -.->|"Provenance checksums"| AuditReceipt

  %% Cross-Stage Feedback & Security Ties
  ReviewLedger -.->|"Mapping change invalidates candidate take"| ReviewService
  JobLedger -.->|"Reconciled candidate available for placement"| PlacementCLI

